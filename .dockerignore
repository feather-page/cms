# Only what the release build needs goes into the build context:
# mix.exs, mix.lock, config/, lib/, priv/, assets/, rel/.

/.git/
/.github/
/.claude/
/.worktrees/
/.kamal/
/.env*

# Build output and dependencies are fetched and compiled in the image.
/_build/
/deps/
/cover/
/doc/
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json

# Local data: SQLite databases, uploaded images, temporary files.
*.db
*.db-*
/storage/
/tmp/
erl_crash.dump

# Not needed in the image.
/test/
/docs/
/ops/
/Dockerfile*
/.dockerignore
