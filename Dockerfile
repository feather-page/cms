# syntax=docker/dockerfile:1
#
# Release image of the CMS. CI builds it on main and pushes it to
# ghcr.io/feather-page/cms; it runs with docker compose (ops/compose.yml).
#
# Volume: /data (SQLite database, image storage and build output).
# The container migrates the database on start (bin/server).

ARG ELIXIR_VERSION=1.19.6
ARG OTP_VERSION=28.5.0.7
ARG DEBIAN_VERSION=trixie-20261005-slim

ARG BUILDER_IMAGE="docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}"
ARG RUNNER_IMAGE="docker.io/debian:${DEBIAN_VERSION}"

# d2 renders the diagram blocks; Dependabot updates the tag and digest, and CI
# installs the same version for the tests.
FROM docker.io/d2lang/d2:v0.9.0@sha256:0f9237e0213338415de5ef7436c92450ddd04e0e6e7df2db3f41387322df97b9 AS d2

# chroma highlights the code blocks. Dependabot cannot update it: bump the
# version and the checksum (from chroma-<version>-checksums.txt of the
# release) by hand. CI installs the same version for the tests.
FROM ${RUNNER_IMAGE} AS chroma
ARG CHROMA_VERSION=2.27.0
ADD --checksum=sha256:91e1cd175006ff8a19cdd45ad12f9dd8c4eeeca4ec85703ebcc09cd31122f802 \
  https://github.com/alecthomas/chroma/releases/download/v${CHROMA_VERSION}/chroma-${CHROMA_VERSION}-linux-amd64.tar.gz \
  /tmp/chroma.tar.gz
RUN tar -xzf /tmp/chroma.tar.gz -C /usr/local/bin chroma

FROM ${BUILDER_IMAGE} AS builder

# nodejs and npm: the asset build installs the ProseMirror packages with npm ci.
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git ca-certificates nodejs npm \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV="prod"

# Dependencies first, for layer caching. vix downloads its precompiled NIF
# and libvips here (priv/precompiled_libvips, linked against glibc and
# libstdc++ only), so no system libvips is needed at build or run time.
COPY mix.exs mix.lock ./
RUN mix deps.get --only $MIX_ENV
RUN mkdir config

# Compile-time config only; runtime.exs is read when the release starts.
COPY config/config.exs config/${MIX_ENV}.exs config/
RUN mix deps.compile

COPY priv priv
COPY lib lib
COPY assets assets

# Compile before the assets: LiveView's colocated hooks are generated by
# the compiler and bundled by esbuild.
RUN mix compile
RUN mix assets.deploy

COPY config/runtime.exs config/
COPY rel rel
RUN mix release

FROM ${RUNNER_IMAGE}

# libstdc++6: needed by vix's libvips. rclone: deployments. brotli:
# precompressed static output. sqlite3: for ops (inspecting and backing up
# /data/feather.db). curl: the health check. d2 and chroma (static
# binaries): diagrams and code highlighting.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libstdc++6 openssl libncurses6 locales ca-certificates \
    rclone brotli sqlite3 curl \
  && rm -rf /var/lib/apt/lists/*

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

COPY --from=d2 /usr/local/bin/d2 /usr/local/bin/d2
COPY --from=chroma /usr/local/bin/chroma /usr/local/bin/chroma

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    MIX_ENV=prod \
    PHX_SERVER=true \
    PORT=4000 \
    DATABASE_PATH=/data/feather.db \
    STORAGE_PATH=/data/storage \
    HOME=/app

RUN groupadd --system --gid 1000 feather \
  && useradd --system --uid 1000 --gid feather --home-dir /app --shell /bin/sh feather \
  && mkdir -p /app /data \
  && chown feather:feather /app /data

WORKDIR /app
COPY --from=builder --chown=feather:feather /app/_build/prod/rel/feather ./

USER feather

VOLUME ["/data"]
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD curl -fsS "http://localhost:${PORT}/up" || exit 1

# bin/server runs the migrations, then starts the release.
CMD ["/app/bin/server"]
