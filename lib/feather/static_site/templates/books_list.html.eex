<%= for {year, books} <- books_by_year(@data.books) do %>
<h2><%= year %> (<%= length(books) %>)</h2>
<div class="books-grid">
  <%= for book <- books do %>
  <div class="book-card">
    <%= if match?(%Image{}, book.cover_image) do %>
    <img src="<%= Routes.image_url(@routes, book.cover_image, :mobile_x1_webp) %>" alt="<%= book.title %>" class="book-cover">
    <% end %>
    <div class="book-info">
      <%= if present?(book.emoji) do %>
      <span class="book-emoji"><%= book.emoji %></span>
      <% end %>
      <%= if review_linked?(@data, book) do %>
      <a href="<%= Routes.post_url(@routes, book.post) %>" class="book-title"><%= book.title %></a>
      <% else %>
      <span class="book-title"><%= book.title %></span>
      <% end %>
      <span class="book-author"><%= book.author %></span>
      <%= if book.rating do %>
      <span class="book-rating"><%= rating_stars(book.rating) %></span>
      <% end %>
      <%= if book.read_at do %>
      <span class="book-date"><%= format_short_date(book.read_at) %></span>
      <% end %>
    </div>
  </div>
  <% end %>
</div>
<% end %>
