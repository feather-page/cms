ErrorDocument 404 <%= @not_found_url %>

<IfModule mod_headers.c>
<%= for {name, value} <- @security_headers do %>  Header always set <%= name %> "<%= value %>"
<% end %>  <FilesMatch "\.svg(\.br|\.gz)?$">
    Header always set Content-Security-Policy "<%= @diagram_content_security_policy %>"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/markdown .md
  AddCharset utf-8 .md .txt
</IfModule>

<%= if @fediverse do %><If "%{REQUEST_URI} =~ m#^/activitypub/#">
  ForceType application/activity+json
</If>
<FilesMatch "^webfinger(\.br|\.gz)?$">
  ForceType application/jrd+json
  <IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
  </IfModule>
</FilesMatch>

<% end %><%= if @redirects != [] do %><IfModule mod_rewrite.c>
  RewriteEngine On
<%= for rule <- @redirects do %>  RewriteRule <%= rule.pattern %> <%= rule.url %> [R=<%= rule.status %>,L]
<% end %></IfModule>

<% end %><IfModule mod_rewrite.c>
  <IfModule mod_headers.c>
    RewriteEngine On

    RewriteCond %{HTTP:Accept} \btext/markdown\b [NC]
    RewriteCond %{REQUEST_FILENAME}/index.md -f
    RewriteRule ^(.*/)?$ $1index.md [L]
<%= for {encoding, suffix} <- @encodings do %>
    RewriteCond %{HTTP:Accept-Encoding} \b<%= encoding %>\b
    RewriteCond %{REQUEST_FILENAME}/index.html<%= suffix %> -f
    RewriteRule ^(.*/)?$ $1index.html<%= suffix %> [L]
    RewriteCond %{HTTP:Accept-Encoding} \b<%= encoding %>\b
    RewriteCond %{REQUEST_FILENAME}<%= suffix %> -f
    RewriteRule ^(.+\.(<%= @extensions %>))$ $1<%= suffix %> [L]
<%= if @fediverse do %>    RewriteCond %{HTTP:Accept-Encoding} \b<%= encoding %>\b
    RewriteCond %{REQUEST_FILENAME}<%= suffix %> -f
    RewriteRule ^(activitypub/.+|\.well-known/webfinger)$ $1<%= suffix %> [L]
<% end %><% end %>
<%= for {extension, content_type} <- @content_types do %>    RewriteRule \.<%= extension %>\.(br|gz)$ - [T=<%= content_type %>,E=no-gzip:1,E=no-brotli:1]
<% end %><%= if @fediverse do %>    RewriteRule ^activitypub/.+\.(br|gz)$ - [T=application/activity+json,E=no-gzip:1,E=no-brotli:1]
    RewriteRule ^\.well-known/webfinger\.(br|gz)$ - [T=application/jrd+json,E=no-gzip:1,E=no-brotli:1]
<% end %>
    <IfModule mod_mime.c>
      RemoveEncoding .br .gz
    </IfModule>
<%= for {encoding, suffix} <- @encodings do %>
    <FilesMatch "\<%= suffix %>$">
      Header always set Content-Encoding <%= encoding %>
    </FilesMatch>
<% end %>
    <FilesMatch "\.(<%= @extensions %>)(\.br|\.gz)?$">
      Header always merge Vary Accept-Encoding
    </FilesMatch>
<%= if @fediverse do %>    <If "%{REQUEST_URI} =~ m#^/(activitypub/|\.well-known/webfinger)#">
      Header always merge Vary Accept-Encoding
    </If>
<% end %>    <FilesMatch "^index\.(html|md)(\.br|\.gz)?$">
      Header always merge Vary Accept
    </FilesMatch>
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^style\.css(\.br|\.gz)?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
