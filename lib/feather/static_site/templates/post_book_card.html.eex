<div class="book-card book-card--detail">
  <div class="book-card-header">
    <%= cond do %>
    <% match?(%Image{}, @book.cover_image) -> %>
    <img src="<%= Routes.image_url(@routes, @book.cover_image, :mobile_x1_webp) %>" alt="" class="book-cover" loading="lazy">
    <% present?(@book.emoji) -> %>
    <span class="book-emoji"><%= @book.emoji %></span>
    <% true -> %>
    <% end %>
    <div class="book-info">
      <div class="book-title"><%= @book.title %></div>
      <div class="book-author"><%= @book.author %></div>
      <%= if @book.rating do %>
      <%= rating(@book.rating, "book-rating") %>
      <% end %>
    </div>
  </div>
</div>
