    <title><%= @document_title %></title>
    <%= cond do %>
    <% @favicon_url -> %>
    <link rel="icon" type="image/png" sizes="192x192" href="<%= @favicon_url %>" />
    <% @page_emoji -> %>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Ctext y=%22.9em%22 font-size=%2290%22%3E<%= @page_emoji %>%3C/text%3E%3C/svg%3E" />
    <% true -> %>
    <% end %>
    <%= if @noindex do %>
    <meta name="robots" content="noindex" />
    <% end %>
    <%= if @description do %>
    <meta name="description" content="<%= @description %>" />
    <% end %>
    <%= if @canonical_url do %>
    <link rel="canonical" href="<%= @canonical_url %>" />
    <meta property="og:type" content="<%= @og_type %>" />
    <meta property="og:title" content="<%= @meta_title %>" />
    <%= if @description do %>
    <meta property="og:description" content="<%= @description %>" />
    <% end %>
    <meta property="og:url" content="<%= @canonical_url %>" />
    <meta property="og:site_name" content="<%= @site.title %>" />
    <%= if og_locale(@site.language_code) do %>
    <meta property="og:locale" content="<%= og_locale(@site.language_code) %>" />
    <% end %>
    <%= if @og_image_url do %>
    <meta property="og:image" content="<%= @og_image_url %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <% end %>
    <% end %>
    <%= if @structured_data do %>
    <script type="application/ld+json"><%= Feather.StaticSite.StructuredData.encode(@structured_data) %></script>
    <% end %>
