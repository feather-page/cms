<!DOCTYPE html>
<html lang="<%= @site.language_code %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= head_meta(assigns) %>
    <link rel="preload" href="<%= font_url(@routes) %>" as="font" type="font/woff2" crossorigin>
    <style><%= font_faces(@routes) %><%= raw(css()) %></style>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22><%= @page_emoji || @site.emoji %></text></svg>">
    <%= if @rss_url do %>
    <link rel="alternate" type="application/rss+xml" href="<%= @rss_url %>" title="<%= @site.title %>" />
    <% end %>
  </head>
  <body>
    <a class="skip-link" href="#main"><%= gettext("Skip to content") %></a>
    <div class="frame">
      <header class="<%= if @is_home, do: "sidebar", else: "sidebar sidebar--bar" %>">
        <div class="identity">
          <%= if @is_home do %>
          <h1 class="site-name"><a href="<%= Routes.home_url(@routes) %>"><%= @site.title %></a></h1>
          <% else %>
          <p class="site-name"><a href="<%= Routes.home_url(@routes) %>"><%= @site.title %></a></p>
          <% end %>
          <%= if show_domain?(@site) do %>
          <p class="site-domain"><%= @site.domain %></p>
          <% end %>
          <%= cond do %>
          <% match?(%Image{}, @site.portrait_image) -> %>
          <%= portrait(@routes, @site.portrait_image) %>
          <% present?(@site.emoji) -> %>
          <span class="portrait portrait--emoji" aria-hidden="true"><%= @site.emoji %></span>
          <% true -> %>
          <% end %>
        </div>
        <%= if present?(@site.bio) do %>
        <p class="bio"><%= @site.bio %></p>
        <% end %>
        <%= if @data.navigation != [] do %>
        <%= site_nav(%{data: @data, routes: @routes, nav: assigns}) %>
        <%= unless @is_home do %>
        <%!-- Phones show this menu instead of the panel list; CSS hides one of the two. --%>
        <details class="nav-menu">
          <summary><%= gettext("Menu") %><span class="nav-menu-sign" aria-hidden="true"></span></summary>
          <%= site_nav(%{data: @data, routes: @routes, nav: assigns}) %>
        </details>
        <% end %>
        <% end %>
        <div class="sidebar-foot">
          <%= if @social_links != [] do %>
          <p class="social-links"><%= social_links(@social_links) %></p>
          <% end %>
          <p class="copyright"><%= copyright(@site.copyright) %></p>
        </div>
      </header>
      <main id="main">
        <%= @inner_content %>
      </main>
      <footer class="site-footer">
        <%= if present?(@site.bio) do %>
        <div class="footer-bio">
          <%= if match?(%Image{}, @site.portrait_image) do %>
          <%= portrait(@routes, @site.portrait_image, "footer-portrait", "48px") %>
          <% end %>
          <p class="bio"><%= @site.bio %></p>
        </div>
        <% end %>
        <%= if @social_links != [] do %>
        <p class="social-links"><%= social_links(@social_links) %></p>
        <% end %>
        <p class="copyright"><%= copyright(@site.copyright) %></p>
      </footer>
    </div>
  </body>
</html>
