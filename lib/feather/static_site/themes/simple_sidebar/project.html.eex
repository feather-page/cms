<article class="project-page">
  <h1><%= emoji_label(@page_emoji, @page_title, "title-emoji") %></h1>
  <%= meta_line([project_status_label(@project.status), project_stack(@project)]) %>
  <%= if present?(@project.short_description) do %>
  <div class="lead"><%= simple_format(@project.short_description) %></div>
  <% end %>
  <%= case page_picture(@project) do %>
  <% nil -> %>
  <% {image, role} -> %>
  <figure class="project-image">
    <img<%= image_sources(@routes, image, variants(role), "(min-width: 52rem) 36rem, calc(100vw - 2rem)") %><%= dimensions(image) %> fetchpriority="high" alt="<%= image.alt %>">
    <%= if unsplash_credit?(image) do %>
    <figcaption class="photo-credit"><%= photo_credit(image) %></figcaption>
    <% end %>
  </figure>
  <% end %>
  <div class="content"><%= Blocks.render(@project.content, @ctx) %></div>
  <dl class="facts">
    <%= for {label, value} <- project_facts(@project) do %>
    <div><dt><%= label %></dt><dd><%= value %></dd></div>
    <% end %>
  </dl>
  <%= case @trail do %>
  <% [projects_page | _] -> %>
  <p class="project-back"><a href="<%= projects_page.url %>"><%= gettext("All projects") %></a></p>
  <% _ -> %>
  <% end %>
</article>
