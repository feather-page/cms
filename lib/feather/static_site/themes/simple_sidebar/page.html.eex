<%= header_image(%{image: @header_image, routes: @routes}) %>
<h1><%= emoji_label(@page_emoji, @page_title, "title-emoji") %></h1>
<div class="content"><%= Blocks.render(@page.content, @ctx) %></div>
<%= tags(%{tags: Content.tag_list(@page)}) %>

<%= if @page.page_type == "books" do %>
<%= books_list(%{data: @data, routes: @routes}) %>
<% end %>

<%= if @page.page_type == "projects" do %>
<%= projects_list(%{projects: @data.projects, routes: @routes}) %>
<% end %>
