<p class="meta"><%= if present?(@post.emoji) do %><span class="meta-emoji" aria-hidden="true"><%= @post.emoji %></span><% end %><span class="meta-label"><%= if @link do %><a class="date-link" href="<%= Routes.post_url(@routes, @post) %>"><%= time_tag(@post.publish_at, &short_date/1) %></a><% else %><%= time_tag(@post.publish_at, &short_date/1) %><% end %><%= sep() %><span class="kind"><%= kind_label(kind(@post)) %></span></span><span class="rule" aria-hidden="true"></span><%= if @new do %><span class="new" role="img" aria-label="<%= gettext("Newest post") %>" title="<%= gettext("Newest post") %>"><%= pgettext("newest post", "New") %></span><% end %></p>
