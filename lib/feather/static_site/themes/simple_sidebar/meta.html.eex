<p class="meta"><%= if present?(@post.emoji) do %><span class="meta-emoji" aria-hidden="true"><%= @post.emoji %></span><% end %><span class="meta-label"><%= if @link do %><a class="date-link" href="<%= Routes.post_url(@routes, @post) %>"><%= date_tag(@post.publish_at) %></a><% else %><%= date_tag(@post.publish_at) %><% end %><span class="sep" aria-hidden="true">·</span><span class="kind"><%= kind_label(kind(@post)) %></span></span><span class="rule" aria-hidden="true"></span><%= if @new do %><span class="new" role="img" aria-label="<%= gettext("Newest post") %>" title="<%= gettext("Newest post") %>"><%= pgettext("newest post", "New") %></span><% end %></p>
