<h1><%= @page_title %></h1>
<p class="not-found-message"><%= gettext("This page does not exist, or it has moved.") %></p>
<ul class="not-found-links">
  <li><a href="<%= Routes.home_url(@routes) %>"><%= gettext("Go to the home page") %></a></li>
  <li><a href="<%= Routes.home_url(@routes) %>#posts"><%= gettext("All posts") %></a></li>
  <%= if @projects_page do %>
  <li><a href="<%= Routes.page_url(@routes, @projects_page) %>"><%= @projects_page.title %></a></li>
  <% end %>
</ul>
