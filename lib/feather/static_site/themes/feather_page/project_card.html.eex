<div class="project-item">
  <div class="project-header">
    <%= cond do %>
    <% match?(%Image{}, @project.thumbnail_image) -> %>
    <img<%= image_sources(@routes, @project.thumbnail_image, variants(:project_thumbnail), "28px") %> alt="" class="project-thumbnail" width="28" height="28" loading="lazy">
    <% present?(@project.emoji) -> %>
    <span class="project-emoji"><%= @project.emoji %></span>
    <% true -> %>
    <% end %>
    <h2 class="project-title"><a href="<%= Routes.project_url(@routes, @project) %>"><%= @project.title %></a></h2>
  </div>
  <div class="project-meta">
    <%= if present?(@project.company) do %>
    <span class="project-company"><%= @project.company %></span>
    <% end %>
    <span class="project-period"><%= project_period(@project) %></span>
    <%= if present?(@project.role) do %>
    <span class="project-role"><%= @project.role %></span>
    <% end %>
  </div>
  <div class="project-badges">
    <span class="badge status-<%= @project.status %>"><%= project_status_label(@project.status) %></span>
    <span class="badge badge-outline"><%= project_type_label(@project.project_type) %></span>
  </div>
  <%= tags(%{tags: Content.tag_list(@project)}) %>
  <%= if present?(@project.short_description) do %>
  <p class="project-description"><%= @project.short_description %></p>
  <% end %>
</div>
