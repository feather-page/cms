<%= for {year, books} <- books_by_year(@data.books) do %>
<h2><%= year %> (<%= length(books) %>)</h2>
<div class="books-grid">
  <%= for book <- books do %>
  <div class="book-card">
    <%= cond do %>
    <% match?(%Image{}, book.cover_image) -> %>
    <img<%= image_sources(@routes, book.cover_image, variants(:book_cover), "120px") %> alt="" class="book-cover" loading="lazy"<%= dimensions(book.cover_image) %>>
    <% present?(book.emoji) -> %>
    <span class="book-emoji"><%= book.emoji %></span>
    <% true -> %>
    <% end %>
    <div class="book-info">
      <%= if review_linked?(book) do %>
      <a href="<%= Routes.post_url(@routes, book.post) %>" class="book-title"><%= book.title %></a>
      <% else %>
      <span class="book-title"><%= book.title %></span>
      <% end %>
      <span class="book-author"><%= book.author %></span>
      <%= if book.rating do %>
      <%= rating(book.rating, "book-rating") %>
      <% end %>
      <%= if book.read_at do %>
      <span class="book-date"><%= time_tag(book.read_at, &format_short_date/1) %></span>
      <% end %>
    </div>
  </div>
  <% end %>
</div>
<% end %>
