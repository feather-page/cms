<figure class="book-card book-card--detail">
  <%= cond do %>
  <% match?(%Image{}, @book.cover_image) -> %>
  <img<%= image_sources(@routes, @book.cover_image, variants(:book_cover), book_cover_sizes()) %> alt="" class="book-cover"<%= dimensions(@book.cover_image) %> loading="lazy">
  <% present?(@book.emoji) -> %>
  <span class="book-emoji"><%= @book.emoji %></span>
  <% true -> %>
  <% end %>
  <figcaption class="book-info">
    <cite class="book-title"><%= @book.title %></cite>
    <span class="book-author"><%= @book.author %></span>
    <%= if @book.rating do %>
    <%= rating(@book.rating, "book-rating") %>
    <% end %>
  </figcaption>
</figure>
