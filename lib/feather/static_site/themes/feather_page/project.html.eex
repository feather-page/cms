<div class="project-detail">
  <div class="project-metadata">
    <div class="project-meta-row">
      <span class="badge status-<%= @project.status %>"><%= project_status_label(@project.status) %></span>
      <%= if present?(@project.company) do %>
      <span class="project-company"><%= @project.company %></span>
      <% end %>
      <span class="project-period"><%= project_period(@project) %></span>
    </div>
    <%= if present?(@project.role) do %>
    <div class="project-role"><%= @project.role %></div>
    <% end %>
    <%= tags(%{tags: Content.tag_list(@project)}) %>
  </div>

  <%= if present?(@project.short_description) do %>
  <div class="project-summary">
    <%= simple_format(@project.short_description) %>
  </div>
  <% end %>
</div>

<%= Blocks.render(@project.content, @ctx) %>

<%= if project_links(@project) != [] do %>
<div class="project-links">
  <h2><%= gettext("Links") %></h2>
  <div class="links-list">
    <%= for link <- project_links(@project) do %>
    <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" class="project-link">
      🔗 <%= if present?(link.label), do: link.label, else: link.url %>
    </a>
    <% end %>
  </div>
</div>
<% end %>
