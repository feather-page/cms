<%= Blocks.render(@data.homepage && @data.homepage.content, @ctx) %>

<hr />

<h2 id="posts"><%= gettext("Posts") %></h2>

<div class="page-list">
  <%= for post <- @posts do %>
  <article>
    <%= if blank?(post.title) do %>
    <%= if book(post) do %><%= post_book_card(%{book: book(post), routes: @routes}) %><% end %>
    <div class="post-shortBody">
      <%= if present?(post.emoji) && is_nil(book(post)) do %>
      <div class="post-emoji"><%= post.emoji %></div>
      <% end %>
      <div class="post-content"><%= Blocks.render(post.content, @ctx) %></div>
    </div>
    <div class="post-date"><a href="<%= Routes.post_url(@routes, post) %>"><%= time_tag(post.publish_at) %></a></div>
    <% else %>
    <h3 class="post-title"><a href="<%= Routes.post_url(@routes, post) %>"><%= post.title %></a><%= if book(post) && book(post).rating do %><%= rating(book(post).rating, "rating") %><% end %></h3>
    <div class="post-long-body">
      <%= if present?(post.emoji) do %>
      <div class="post-emoji"><%= post.emoji %></div>
      <% end %>
      <div class="post-long-content">
        <%= if match?(%Image{}, post.thumbnail_image) do %>
        <div class="post-thumbnail">
          <img<%= image_sources(@routes, post.thumbnail_image, variants(:thumbnail), "(max-width: 600px) calc(100vw - 2rem), 240px") %><%= dimensions(post.thumbnail_image) %> alt="" loading="lazy">
        </div>
        <% end %>
        <%= if post.content not in [nil, []] do %>
        <div class="post-excerpt"><%= Content.content_excerpt(post) %></div>
        <% end %>
      </div>
    </div>
    <div class="post-date"><%= time_tag(post.publish_at) %></div>
    <%= tags(%{tags: Content.tag_list(post)}) %>
    <% end %>
  </article>
  <% end %>
</div>

<%= if @total_pages > 1 do %>
<nav class="pagination" aria-label="<%= gettext("Pagination") %>">
  <%= if @current_page > 1 do %>
  <a href="<%= Routes.home_url(@routes, @current_page - 1) %>" class="pagination-link" aria-label="<%= gettext("Previous page") %>">&larr;</a>
  <% end %>
  <%= for page <- pagination_page_numbers(@current_page, @total_pages) do %>
  <%= cond do %>
  <% page == :gap -> %>
  <span class="pagination-gap">&hellip;</span>
  <% page == @current_page -> %>
  <span class="pagination-current" aria-current="page"><%= page %></span>
  <% true -> %>
  <a href="<%= Routes.home_url(@routes, page) %>" class="pagination-link"><%= page %></a>
  <% end %>
  <% end %>
  <%= if @current_page < @total_pages do %>
  <a href="<%= Routes.home_url(@routes, @current_page + 1) %>" class="pagination-link" aria-label="<%= gettext("Next page") %>">&rarr;</a>
  <% end %>
</nav>
<% end %>
