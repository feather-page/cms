# Secrets for config/deploy.yml, from the same 1Password item as the Rails app.
# CONFIG_ENCRYPTION_KEY and UNSPLASH_ACCESS_KEY must exist in the item before
# the first Phoenix deploy; generate the key with
#   elixir -e 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
SECRETS=$(kamal secrets fetch --adapter 1password --account 5PO67Z57YVFINASKGIG4W3T4EQ --from "feather.page/Production" KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE CONFIG_ENCRYPTION_KEY BASE_HOSTNAME_AND_PORT SMTP_ADDRESS SMTP_PORT SMTP_USERNAME SMTP_PASSWORD UNSPLASH_ACCESS_KEY)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
CONFIG_ENCRYPTION_KEY=$(kamal secrets extract CONFIG_ENCRYPTION_KEY $SECRETS)
BASE_HOSTNAME_AND_PORT=$(kamal secrets extract BASE_HOSTNAME_AND_PORT $SECRETS)
SMTP_ADDRESS=$(kamal secrets extract SMTP_ADDRESS $SECRETS)
SMTP_PORT=$(kamal secrets extract SMTP_PORT $SECRETS)
SMTP_USERNAME=$(kamal secrets extract SMTP_USERNAME $SECRETS)
SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
UNSPLASH_ACCESS_KEY=$(kamal secrets extract UNSPLASH_ACCESS_KEY $SECRETS)
